@theme "/dev/null"

configuration {
    show-icons: true;
    display-drun: "";
    drun-display-format: "{name}";
    hover-select: true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
}

* {
    bg-base: #10151CEB;
    surface: #ffffff0a;
    surface-border: #ffffff1c;
    fg: #f1f5fa;
    muted: #9aa8b8;
    mac-blue: #69b7ff;
    mac-blue-soft: #69b7ff24;

    font: "SF Pro Text 12", "Sans 12";
    background-color: transparent;
    text-color: @fg;
}

window {
    width:            1160px;
    height:           680px;
    background-color: @bg-base;
    border:           1px;
    border-color:     @surface-border;
    border-radius:    24px;
    padding:          14px;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 10px;
}

inputbar {
    spacing:          10px;
    padding:          9px 14px;
    children:         [ prompt, entry ];
    border:           1px;
    border-color:      @surface-border;
    background-color:  @surface;
    border-radius:     12px;
}

prompt {
    text-color:       @muted;
    font:              "Sans 13";
    vertical-align:   0.5;
}

entry {
    text-color:        @fg;
    placeholder:       "Search wallpapers...";
    placeholder-color: @muted;
    vertical-align:    0.5;
    font:              "SF Pro Text 13", "Sans 13";
    cursor:            text;
}

listview {
    padding:          14px 10px 10px 10px;
    columns:          4;
    lines:            2;
    spacing:          18px;
    cycle:            true;
    dynamic:          true;
    layout:           vertical;
    fixed-columns: true;
    fixed-height:     true;
    border:           0px;
}

element {
    orientation:       vertical;
    padding:           9px;
    spacing:           9px;
    border-radius:     16px;
    border:            0px;
    background-color:  transparent;
    cursor:            pointer;
}

element-icon {
    size:              214px;
    horizontal-align:  0.5;
    vertical-align:    0.5;
    border-radius:     12px;
    background-color:  transparent;
    cursor:            inherit;
}

element-text {
    horizontal-align:  0.5;
    vertical-align:    0.5;
    padding:           2px 4px 0px 4px;
    font:              "SF Pro Text 11", "Sans 11";
    text-color:        inherit;
    background-color:  transparent;
}

element normal.normal, element alternate.normal {
    background-color: transparent;
    text-color:       @fg;
}

element selected.normal {
    background-color: @mac-blue-soft;
    border:           2px;
    border-color:     @mac-blue;
    text-color:       #ffffff;
}

element selected element-icon, element selected element-text,
element-icon, element-text {
    background-color: transparent;
}
