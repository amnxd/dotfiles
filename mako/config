# Geometry & Placement
anchor=top-right
margin=15,15,0,0
padding=12,15
width=280
height=80
border-size=1
border-radius=3

# Colors (Stealthy dark theme with a very subtle border)
background-color=#ebdbb2
text-color=#3c3836
border-color=#1e1e2e
progress-color=over #313244

# Typography & Behavior
font=JetBrains Nerd Font 10
default-timeout=4000
icons=1
max-icon-size=20
layer=overlay

# Overrides
[urgency=high]
border-color=#f38ba8

# Interaction
on-button-left=invoke-default-action
on-button-right=dismiss
on-button-middle=dismiss-all