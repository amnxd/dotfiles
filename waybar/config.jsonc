{
    "reload_style_on_change": true,
    "layer": "top",
    "position": "top",
    "mod": "dock",
    "margin-top": 0,
    "height": 20,
    "margin-left": 5,
    "margin-right": 5,
    "margin-bottom": 0,
    "modules-left": [
        "custom/arch",
        "clock",
        "custom/weather",
        "idle_inhibitor",
        "hyprland/workspaces",
        "mpris",
        "custom/updatespacman"
    ],
    "modules-center": [
        "hyprland/window"
    ],
    "modules-right": [
        "tray",
        "backlight",
        "bluetooth",
        "pulseaudio",
        "network",
        "memory",
        "battery",
        "cpu"
    ],
    "hyprland/workspaces": {
        "on-click": "activate",
        "disable-scroll": true,
        "tooltip": true,
        "tooltip-format": "Workspace {id}: {name}\n{windows}"
    },
    "custom/arch": {
        "format": "",
        "exec": "uname -r",
        "interval": "once",
        "tooltip": true,
        "tooltip-format": "Arch Linux | Kernel: {}",
        "on-click": "rofi -show drun -show-icons -theme ~/.config/rofi/config_app_luancher.rasi",
        "on-click-right": "kitty"
    },
    "custom/updatespacman": {
        "format": "{}{icon}",
        "return-type": "json",
        "format-icons": {
            "has-updates": " 󰏖",
            "updated": ""
        },
        "exec-if": "which waybar-module-pacman-updates",
        "exec": "waybar-module-pacman-updates --no-zero-output"
    },
    "hyprland/window": {
        "format": "{}",
        "rewrite": {
            "(.*) (-|—) Mozilla Firefox(.*)": "  $1",
            "(.*) - VSCodium(.*)": "  $1",
            "(.*) - Code - OSS(.*)": "  $1",
            "(.*) - Visual Studio Code(.*)": "  $1",
            "(.*) - Discord(.*)": "  $1",
            "(.*) - Telegram(.*)": "  $1",
            "(.*) - Steam(.*)": "  $1",
            "(.*) - Counter-Strike 2(.*)": "󰊴  $1",
            "(.*) - LibreOffice(.*)": "󰏆  $1",
            "(.*) - VLC media player(.*)": "󰕼  $1",
            "(.*) - mpv(.*)": "  $1",
            "(.*) - Dolphin(.*)": "󰉋  $1",
            "(.*) - Files(.*)": "󰉋  $1",
            "(.*) - Virtual Machine Manager(.*)": "󰢹  $1",
            "(.*) - QEMU(.*)": "󰢹  $1",
            "(.*) - Burp Suite(.*)": "󰆈  $1",
            "(.*) - Wireshark(.*)": "󰈃  $1",
            "(.*) - Ghidra(.*)": "󰆈  $1",
            "(.*) - Postman(.*)": "󰛮  $1",
            "(.*) - Volume Control(.*)": "󰕾  $1",
            "(.*) - Settings(.*)": "󰒓  $1",
            "(.*)Settings(.*)": "⚙ $1",
            "^~$": "󰊠  ~",
            "(.*)kitty(.*)": "󰊠  $1",
            "(.*) — Kitty": "󰊠  $1",
            "(bash|zsh|fish)": "󰊠  $1",
            "(.*) - Neovim(.*)": "  $1",
            "^.*btop(.*)$": "󰧨  BTOP",
            "^.*cmatrix(.*)$": "󰘨  MATRIX"
        }
    },
    "cpu": {
        "interval": 2,
        "format": "{usage}% 󰍛",
        "on-click": "kitty -e btop",
        "tooltip-format": "CPU usage: {usage}%\nClick to open btop"
    },
    "memory": {
        "interval": 2,
        "format": "{percentage}%  ",
        "on-click": "kitty -e btop",
        "tooltip-format": "Memory usage: {percentage}%\nClick to open btop"
    },
    "clock": {
        "format": " {:%H:%M %a}",
        "format-alt": " {:%d/%m/%Y  %H:%M:%S}",
        "tooltip-format": "<span>{calendar}</span>",
        "calendar": {
            "mode": "month",
            "weeks-pos": "right",
            "mode-mon-col": 3,
            "on-click-right": "mode",
            "format": {
                "month": "<span color='#ffead3'><b>{}</b></span>",
                "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
                "today": "<span color='#ff6699'><b>{}</b></span>"
            }
        }
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "tooltip-format": "Idle inhibitor: {status}",
        "format-icons": {
            "activated": "󰛊",
            "deactivated": "󰾫"
        }
    },
    "network": {
        "format-icons": [
            "󰤯",
            "󰤟",
            "󰤢",
            "󰤥",
            "󰤨"
        ],
        "format": "{icon}",
        "format-wifi": "{icon}",
        "format-ethernet": "󰀂",
        "format-disconnected": "󰖪",
        "tooltip-format-wifi": "{essid} ({frequency} GHz)\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
        "tooltip-format-ethernet": "⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
        "tooltip-format-disconnected": "Disconnected",
        "interval": 3,
        "nospacing": 1,
        "on-click": "nm-connection-editor"
    },
    "battery": {
        "format": "{capacity}% {icon}",
        "format-discharging": "{capacity}% {icon}",
        "format-charging": "{icon}",
        "format-plugged": "",
        "format-icons": {
            "charging": [
                "󰢜",
                "󰂆",
                "󰂇",
                "󰂈",
                "󰢝",
                "󰂉",
                "󰢞",
                "󰂊",
                "󰂋",
                "󰂅"
            ],
            "default": [
                "󰁺",
                "󰁻",
                "󰁼",
                "󰁽",
                "󰁾",
                "󰁿",
                "󰂀",
                "󰂁",
                "󰂂",
                "󰁹"
            ]
        },
        "format-full": "󰂅",
        "tooltip-format-discharging": "{timeTo}",
        "tooltip-format-charging": "{timeTo}",
        "tooltip-format": "Battery: {capacity}%\n{timeTo}",
        "interval": 5,
        "on-click": "~/.local/bin/powermenu",
        "states": {
            "warning": 20,
            "critical": 10
        }
    },
    "bluetooth": {
        "format": "",
        "format-disabled": "󰂲",
        "format-off": "󰂲",
        "format-connected": "",
        "tooltip-format": "Devices connected: {num_connections}",
        "on-click": "blueman-manager"
    },
    "backlight": {
        "device": "intel_backlight",
        "format": "{icon}",
        "tooltip-format": "Brightness: {percent}%\nScroll to adjust",
        "format-icons": [
            "[------]",
            "[█-----]",
            "[██----]",
            "[███---]",
            "[████--]",
            "[█████-]",
            "[██████]",
            "[███████]",
            "[████████]",
            "[█████████]",
            "[██████████]"
        ],
        "scroll-step": 5,
        "on-scroll-up": "brightnessctl set 5%+",
        "on-scroll-down": "brightnessctl set 5%-"
    },
    "custom/weather": {
        "format": "{}°",
        "tooltip": true,
        "interval": 1800,
        "exec": "wttrbar --nerd --location Patna",
        "return-type": "json",
        "tooltip-format": "Weather in Patna: {}"
    },
    "pulseaudio": {
        "format": "{icon}",
        "on-click": "pavucontrol",
        "on-click-right": "pamixer -t",
        "tooltip-format": "Volume: {volume}%\nScroll to change volume\nRight-click to mute",
        "scroll-step": 5,
        "format-muted": "",
        "format-icons": {
            "default": [
                "[------]",
                "[█-----]",
                "[██----]",
                "[███---]",
                "[████--]",
                "[█████-]",
                "[██████]",
                "[███████]",
                "[████████]",
                "[█████████]",
                "[██████████]"
            ]
        }
    },
    "tray": {
        "icon-size": 12,
        "spacing": 10
    },
    "mpris": {
        "format": "{player_icon} {artist} - {title} [{position}/{length}]",
        "format-paused": "<span color='black'>{status_icon} {artist} - {title} [{position}/{length}]</span>",
        "max-length": 45,
        "tooltip-format": "{artist} - {title}\n{position}/{length}",
        "interval": 1,
        "player-icons": {
            "default": "",
            "mpv": "󰕼",
            "vlc": "󰕼",
            "firefox": "󰈹",
            "chromium": "",
            "spotify": ""
        },
        "status-icons": {
            "paused": "⏸"
        },
        "ignored-players": []
    }
}